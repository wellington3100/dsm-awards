-- 4. PERMISOS DE TABLA (mínimo necesario)
-- ------------------------------------------------------------

revoke all on public.categories, public.cars, public.nominations,
              public.settings, public.voters, public.votes,
              public.admins, public.failed_attempts
    from anon, authenticated;

grant select on public.categories, public.cars,
                public.nominations, public.settings to anon, authenticated;

-- El admin solo puede activar/desactivar categorías (los nombres son oficiales):
grant update (is_active) on public.categories to authenticated;
grant insert, update, delete on public.cars to authenticated;
grant insert, delete on public.nominations to authenticated;

-- ------------------------------------------------------------
-- 5. FUNCIONES PÚBLICAS (votantes)
-- ------------------------------------------------------------

-- Uso interno: devuelve el id del votante dueño del código (o null).
create or replace function public._voter_id(p_code text)
returns uuid
language plpgsql stable security definer
set search_path = public, extensions
as $$
declare
    v_norm text;
    v_id   uuid;
begin
    v_norm := upper(regexp_replace(coalesce(p_code, ''), '[^A-Za-z0-9]', '', 'g'));
    if char_length(v_norm) <> 10 then
        return null;
    end if;
    select id into v_id
    from public.voters
    where code_hash = encode(digest(v_norm, 'sha256'), 'hex')
      and not revoked;
    return v_id;
end;
$$;

-- Valida un código. Devuelve {valid, label, voted:[category_id...]}.
-- Limita intentos fallidos (40 cada 5 minutos en total) para frenar
-- adivinanzas por fuerza bruta.
create or replace function public.verify_code(p_code text)
returns jsonb
language plpgsql security definer
set search_path = public, extensions
as $$
declare
    v_id    uuid;
    v_label text;
    v_voted jsonb;
begin
    if (select count(*) from public.failed_attempts
         where at > now() - interval '5 minutes') >= 40 then
        return jsonb_build_object('valid', false, 'error', 'too_many_attempts');
    end if;

    v_id := public._voter_id(p_code);

    if v_id is null then
        insert into public.failed_attempts default values;
        delete from public.failed_attempts where at < now() - interval '1 day';
        return jsonb_build_object('valid', false, 'error', 'invalid_code');
    end if;

    select label into v_label from public.voters where id = v_id;
    select coalesce(jsonb_agg(category_id), '[]'::jsonb) into v_voted
      from public.votes where voter_id = v_id;

    return jsonb_build_object('valid', true, 'label', v_label, 'voted', v_voted);
end;
$$;

-- Registra un voto. Toda la validación ocurre aquí, en el servidor.
create or replace function public.cast_vote(p_code text, p_category_id uuid, p_car_id uuid)
returns jsonb
language plpgsql security definer
set search_path = public, extensions
as $$
declare
    v_id   uuid;
    v_open boolean;
begin
    if (select count(*) from public.failed_attempts
         where at > now() - interval '5 minutes') >= 40 then
        return jsonb_build_object('ok', false, 'error', 'too_many_attempts');
    end if;

    v_id := public._voter_id(p_code);
    if v_id is null then
        insert into public.failed_attempts default values;
        return jsonb_build_object('ok', false, 'error', 'invalid_code');
    end if;

    select voting_open into v_open from public.settings where id = 1;
    if not coalesce(v_open, false) then
        return jsonb_build_object('ok', false, 'error', 'voting_closed');
    end if;

    if not exists (select 1 from public.categories where id = p_category_id and is_active) then
        return jsonb_build_object('ok', false, 'error', 'category_inactive');
    end if;

    if not exists (select 1 from public.nominations
                    where category_id = p_category_id and car_id = p_car_id) then
        return jsonb_build_object('ok', false, 'error', 'not_nominated');
    end if;

    begin
        insert into public.votes (voter_id, category_id, car_id)
        values (v_id, p_category_id, p_car_id);
    exception when unique_violation then
        return jsonb_build_object('ok', false, 'error', 'already_voted');
    end;

    return jsonb_build_object('ok', true);
end;
$$;

-- Ganadores públicos: solo devuelve filas si el admin reveló los resultados.
-- Nunca devuelve conteos. En caso de empate devuelve a todos los empatados.
create or replace function public.public_results()
returns table (category_id uuid, car_id uuid)
language sql stable security definer
set search_path = public
as $$
    with counts as (
        select n.category_id, n.car_id, count(v.id) as c
        from public.nominations n
        join public.categories k on k.id = n.category_id and k.is_active
        left join public.votes v
               on v.category_id = n.category_id and v.car_id = n.car_id
        group by n.category_id, n.car_id
    ), ranked as (
        select counts.category_id, counts.car_id, counts.c,
               max(counts.c) over (partition by counts.category_id) as m
        from counts
    )
    select r.category_id, r.car_id
    from ranked r
    where r.c = r.m and r.m > 0
      and coalesce((select s.results_revealed from public.settings s where s.id = 1), false);
$$;

-- ------------------------------------------------------------
-- 6. FUNCIONES DE ADMINISTRADOR
--    Cada una verifica is_admin() antes de hacer nada.
-- ------------------------------------------------------------

create or replace function public.admin_results()
returns table (category_id uuid, car_id uuid, votes bigint)
language plpgsql stable security definer
set search_path = public
as $$
begin
    if not public.is_admin() then
        raise exception 'forbidden';
    end if;
    return query
        select n.category_id, n.car_id, count(v.id)
        from public.nominations n
        left join public.votes v
               on v.category_id = n.category_id and v.car_id = n.car_id
        group by n.category_id, n.car_id;
end;
$$;

create or replace function public.admin_list_voters()
returns table (voter_id uuid, label text, revoked boolean, created_at timestamptz, votes_cast bigint)
language plpgsql stable security definer
set search_path = public
as $$
begin
    if not public.is_admin() then
        raise exception 'forbidden';
    end if;
    return query
        select v.id, v.label, v.revoked, v.created_at, count(x.id)
        from public.voters v
        left join public.votes x on x.voter_id = v.id
        group by v.id
        order by v.created_at, v.label;
end;
$$;

-- Genera un código por nombre. Los códigos SOLO se devuelven aquí, una vez.
create or replace function public.admin_create_codes(p_labels text[])
returns jsonb
language plpgsql security definer
set search_path = public, extensions
as $$
declare
    v_label    text;
    v_code     text;
    v_alphabet constant text := 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    v_out      jsonb := '[]'::jsonb;
    i          int;
begin
    if not public.is_admin() then
        raise exception 'forbidden';
    end if;
    if p_labels is null or coalesce(array_length(p_labels, 1), 0) = 0 then
        raise exception 'no_labels';
    end if;
    if array_length(p_labels, 1) > 300 then
        raise exception 'too_many_labels';
    end if;

    foreach v_label in array p_labels loop
        v_label := left(btrim(v_label), 80);
        continue when v_label = '';

        v_code := '';
        for i in 1..10 loop
            v_code := v_code || substr(v_alphabet, 1 + (get_byte(gen_random_bytes(1), 0) % 32), 1);
        end loop;

        insert into public.voters (label, code_hash)
        values (v_label, encode(digest(v_code, 'sha256'), 'hex'));

        v_out := v_out || jsonb_build_object(
            'label', v_label,
            'code',  left(v_code, 5) || '-' || right(v_code, 5)
        );
    end loop;

    return v_out;
end;
$$;

create or replace function public.admin_revoke_voter(p_voter_id uuid, p_revoked boolean)
returns void
language plpgsql security definer
set search_path = public
as $$
begin
    if not public.is_admin() then
        raise exception 'forbidden';
    end if;
    update public.voters set revoked = p_revoked where id = p_voter_id;
end;
$$;

-- Abre/cierra la votación y oculta/revela resultados.
-- Los resultados no se pueden revelar con la votación abierta.
create or replace function public.admin_set_state(p_voting_open boolean, p_results_revealed boolean)
returns void
language plpgsql security definer
set search_path = public
as $$
begin
    if not public.is_admin() then
        raise exception 'forbidden';
    end if;
    if p_voting_open and p_results_revealed then
        raise exception 'close_voting_first';
    end if;
    update public.settings
       set voting_open = p_voting_open,
           results_revealed = p_results_revealed
     where id = 1;
end;
$$;


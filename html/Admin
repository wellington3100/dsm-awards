<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>Administración | DSM Awards</title>
    <meta name="theme-color" content="#090909">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="../css/styles.css">
    <link rel="stylesheet" href="../css/admin.css">
</head>
<body class="admin">

<header class="site-header">
    <nav class="navbar" aria-label="Administración">
        <span class="logo">DSM<span>AWARDS</span> <small class="admin-badge">Admin</small></span>
        <div class="admin-header-actions">
            <a class="btn btn-ghost" href="../index.html">Ver sitio</a>
            <button class="btn btn-ghost" id="btn-salir" type="button" hidden>Cerrar sesión</button>
        </div>
    </nav>
</header>

<main class="admin-main" id="contenido">

    <div id="aviso" role="status" aria-live="polite"></div>

    <!-- ============ Inicio de sesión ============ -->
    <section class="admin-card admin-login" id="vista-login">
        <h1>Acceso del administrador</h1>
        <form id="form-login" autocomplete="on">
            <div class="field">
                <label for="email">Correo</label>
                <input id="email" name="email" type="email" required autocomplete="username">
            </div>
            <div class="field">
                <label for="password">Contraseña</label>
                <input id="password" name="password" type="password" required autocomplete="current-password">
            </div>
            <p class="form-error" id="login-error" role="alert"></p>
            <button class="btn btn-primary" type="submit" id="btn-login">Entrar</button>
        </form>
    </section>

    <!-- ============ Panel ============ -->
    <div id="vista-panel" hidden>

        <div class="admin-tabs" role="tablist" aria-label="Secciones del panel">
            <button class="admin-tab is-active" role="tab" id="tab-btn-vehiculos" aria-selected="true" aria-controls="panel-vehiculos" data-tab="vehiculos" type="button">Vehículos</button>
            <button class="admin-tab" role="tab" id="tab-btn-categorias" aria-selected="false" aria-controls="panel-categorias" data-tab="categorias" type="button">Categorías</button>
            <button class="admin-tab" role="tab" id="tab-btn-votantes" aria-selected="false" aria-controls="panel-votantes" data-tab="votantes" type="button">Votantes y códigos</button>
            <button class="admin-tab" role="tab" id="tab-btn-votacion" aria-selected="false" aria-controls="panel-votacion" data-tab="votacion" type="button">Votación y resultados</button>
        </div>

        <!-- ---------- Vehículos ---------- -->
        <section class="admin-panel" id="panel-vehiculos" role="tabpanel" aria-labelledby="tab-btn-vehiculos">
            <div class="admin-split">
                <div class="admin-card">
                    <h2 id="titulo-form-auto">Nuevo vehículo</h2>
                    <form id="form-auto">
                        <input type="hidden" name="id">
                        <div class="field">
                            <label for="a-propietario">Propietario</label>
                            <input id="a-propietario" name="propietario" type="text" maxlength="80" required>
                        </div>
                        <div class="field">
                            <label for="a-generacion">Generación</label>
                            <input id="a-generacion" name="generacion" type="text" maxlength="60" list="generaciones" required>
                            <datalist id="generaciones">
                                <option value="1G (1990-1994)">
                                <option value="2G (1995-1999)">
                                <option value="3G (2000-2005)">
                                <option value="4G (2006-2012)">
                            </datalist>
                        </div>
                        <div class="field">
                            <label for="a-descripcion">Descripción</label>
                            <textarea id="a-descripcion" name="descripcion" rows="4" maxlength="400"></textarea>
                        </div>
                        <div class="field">
                            <label for="a-foto">Fotografía (JPG, PNG o WebP, máx. 5 MB)</label>
                            <input id="a-foto" name="foto" type="file" accept="image/jpeg,image/png,image/webp">
                            <img class="photo-preview" id="foto-preview" alt="Vista previa de la fotografía" hidden>
                        </div>
                        <div class="form-actions">
                            <button class="btn btn-primary" id="btn-guardar-auto" type="submit">Guardar vehículo</button>
                            <button class="btn btn-ghost" id="btn-cancelar-auto" type="button" hidden>Cancelar edición</button>
                        </div>
                    </form>
                </div>

                <div class="admin-card">
                    <h2>Vehículos registrados</h2>
                    <ul class="admin-list" id="lista-autos-admin"></ul>
                </div>
            </div>
        </section>

        <!-- ---------- Categorías ---------- -->
        <section class="admin-panel" id="panel-categorias" role="tabpanel" aria-labelledby="tab-btn-categorias" hidden>
            <div class="admin-split admin-split-narrow">
                <div class="admin-card">
                    <h2>Las 11 categorías</h2>
                    <ul class="admin-list" id="lista-cats-admin"></ul>
                </div>
                <div class="admin-card" id="detalle-cat"></div>
            </div>
        </section>

        <!-- ---------- Votantes ---------- -->
        <section class="admin-panel" id="panel-votantes" role="tabpanel" aria-labelledby="tab-btn-votantes" hidden>
            <div class="admin-card">
                <h2>Generar códigos de votante</h2>
                <p class="hint">Escribe un nombre por línea. Se crea un código único por persona. Los códigos se muestran <strong>una sola vez</strong>: cópialos o descárgalos antes de salir.</p>
                <form id="form-codigos">
                    <div class="field">
                        <label for="v-nombres">Nombres (uno por línea)</label>
                        <textarea id="v-nombres" name="nombres" rows="6" placeholder="Nombre 1&#10;Nombre 2"></textarea>
                    </div>
                    <button class="btn btn-primary" type="submit" id="btn-generar">Generar códigos</button>
                </form>
                <div id="codigos-generados" hidden></div>
            </div>

            <div class="admin-card">
                <h2>Votantes</h2>
                <p class="hint" id="resumen-votantes"></p>
                <div class="table-wrap">
                    <table class="admin-table">
                        <thead><tr><th>Nombre</th><th>Estado</th><th>Votos emitidos</th><th></th></tr></thead>
                        <tbody id="lista-votantes"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ---------- Votación y resultados ---------- -->
        <section class="admin-panel" id="panel-votacion" role="tabpanel" aria-labelledby="tab-btn-votacion" hidden>
            <div class="state-grid" id="estado-votacion"></div>

            <div class="admin-card">
                <div class="admin-card-head">
                    <h2>Resultados completos (privados)</h2>
                    <div class="form-actions">
                        <button class="btn btn-ghost" id="btn-refrescar" type="button">Actualizar</button>
                        <button class="btn btn-ghost" id="btn-csv-resultados" type="button">Descargar CSV</button>
                    </div>
                </div>
                <p class="hint" id="resumen-votacion"></p>
                <div id="resultados-admin"></div>
            </div>
        </section>

    </div>
</main>

<script src="../js/config.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.js"></script>
<script src="../js/api.js"></script>
<script src="../js/admin.js"></script>
</body>
</html>

grant execute on function public.cast_vote(text, uuid, uuid)          to anon, authenticated;
grant execute on function public.public_results()                     to anon, authenticated;

grant execute on function public.admin_results()                      to authenticated;
grant execute on function public.admin_list_voters()                  to authenticated;
grant execute on function public.admin_create_codes(text[])           to authenticated;
grant execute on function public.admin_revoke_voter(uuid, boolean)    to authenticated;
grant execute on function public.admin_set_state(boolean, boolean)    to authenticated;

